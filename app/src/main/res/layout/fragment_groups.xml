<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/groups_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="10dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_groups"
                android:textSize="26sp"
                android:fontFamily="@font/tajawal_bold" />
            <TextView
                android:id="@+id/subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="جميع محادثاتك ونقاشاتك في مكان واحد"
                android:textSize="13sp"
                android:fontFamily="@font/tajawal_medium"
                android:textColor="@color/day_text_secondary" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_sort_groups"
        android:layout_width="48dp"
        android:layout_height="50dp"
            android:layout_marginEnd="6dp"
            android:padding="11dp"
            android:src="@drawable/ic_filter"
            app:tint="@color/day_text_secondary"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="ترتيب المجموعات" />

        <ImageButton
            android:id="@+id/btn_add_group"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@drawable/ic_add"
            app:tint="#FFFFFF"
            android:background="@drawable/scanner_fab_bg"
            android:contentDescription="@string/new_group" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/groups_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="120dp"
        android:padding="28dp"
        android:background="@drawable/empty_state_bg"
        android:clipToPadding="false"
        android:paddingBottom="120dp" />

    <TextView
        android:id="@+id/groups_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="40dp"
        android:text="لا توجد مجموعات بعد. اضغط هنا لإنشاء مجموعتك الأولى."
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:textSize="15sp"
        android:lineSpacingExtra="4dp"
        android:fontFamily="@font/tajawal_medium"
        android:textColor="@color/day_text_secondary"
        android:visibility="visible" />

</LinearLayout>
