<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/group_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/chat_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:background="@drawable/compose_bar_bg"
        android:elevation="3dp"
        android:paddingStart="10dp"
        android:paddingEnd="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:src="@drawable/ic_close"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/close" />

        <ImageView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="2dp"
            android:background="@drawable/circle_primary"
            android:contentDescription="صورة المجموعة"
            android:padding="10dp"
            android:src="@drawable/ic_invoice"
            app:tint="#FFFFFF" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/group_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/tajawal_bold"
                android:maxLines="1"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/group_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:fontFamily="@font/tajawal_regular"
                android:maxLines="1"
                android:text="محادثة مجموعة محلية"
                android:textSize="12sp" />
        </LinearLayout>


    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="4dp"
        android:paddingStart="20dp"
        android:paddingEnd="14dp">

        <EditText
            android:id="@+id/et_search"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:importantForAutofill="no"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:background="@drawable/input_bg"
            android:hint="@string/search_group_hint"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_filter"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:text="@string/filter"
            android:textSize="13sp"
            android:fontFamily="@font/tajawal_medium"
            app:cornerRadius="14dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_reset"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:text="@string/reset_search"
            android:textSize="13sp"
            android:fontFamily="@font/tajawal_medium"
            app:cornerRadius="14dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/selection_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:padding="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/selected_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textSize="14sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancel_select"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="@string/cancel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_share_selected"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="@string/share" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_delete_selected"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="@string/delete_all" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/items_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="8dp"
            android:paddingTop="12dp"
            android:paddingEnd="8dp"
            android:paddingBottom="12dp"
            android:clipToPadding="false" />

        <LinearLayout
            android:id="@+id/group_empty_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="28dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:src="@drawable/ic_invoice"
                android:contentDescription="حالة المجموعة" />

            <TextView
                android:id="@+id/group_empty_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/tajawal_bold"
                android:gravity="center"
                android:text="لا توجد رسائل بعد"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/group_empty_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/tajawal_regular"
                android:gravity="center"
                android:text="اكتب رسالة أو أضف صورة لبدء المحادثة"
                android:textSize="13sp" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/attachment_preview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="6dp"
        android:gravity="center_vertical"
        android:padding="8dp"
        android:visibility="gone"
        android:background="@drawable/compose_bar_bg">

        <ImageView
            android:id="@+id/attachment_thumb"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="معاينة الصورة"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/attachment_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="6dp"
            android:text="الصورة جاهزة — اكتب نصًا اختياريًا ثم أضفها"
            android:textSize="13sp"
            android:fontFamily="@font/tajawal_regular" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_add_attachment"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="إضافة إلى المجموعة"
            android:textSize="12sp"
            android:fontFamily="@font/tajawal_bold"
            app:cornerRadius="12dp" />

        <ImageView
            android:id="@+id/btn_remove_attachment"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="10dp"
            android:src="@drawable/ic_close"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="إلغاء الصورة" />
    </LinearLayout>

    <!-- شريط الإرسال السفلي (مثل تليجرام/واتساب) -->
    <LinearLayout
        android:id="@+id/compose_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="7dp"
        android:paddingBottom="7dp"
        android:elevation="4dp"
        android:background="@drawable/compose_bar_bg">

        <ImageView
            android:id="@+id/btn_attach"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="9dp"
            android:src="@drawable/ic_image_attach"
            app:tint="@color/accent"
            android:background="@drawable/circle_primary"
            android:backgroundTint="@color/day_surface_high"
            android:contentDescription="إضافة صورة" />

        <EditText
            android:id="@+id/et_message"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/compose_input_bg"
            android:hint="اكتب رسالة..."
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:imeOptions="actionSend"
            android:inputType="textMultiLine"
            android:maxLines="3"
            android:textSize="15sp" />

        <ImageView
            android:id="@+id/btn_send"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_send"
            app:tint="#FFFFFF"
            android:background="@drawable/scanner_fab_bg"
            android:padding="12dp"
            android:elevation="4dp"
            android:contentDescription="إرسال" />
    </LinearLayout>

</LinearLayout>
