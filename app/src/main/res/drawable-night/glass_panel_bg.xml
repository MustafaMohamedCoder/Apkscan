<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/night_surface_high" />
            <corners android:radius="24dp" />
            <stroke android:width="1dp" android:color="@color/night_card_stroke" />
        </shape>
    </item>
    <item android:height="34dp" android:gravity="top">
        <shape android:shape="rectangle">
            <gradient android:angle="90" android:startColor="@color/glass_shine_night" android:endColor="#00000000" />
            <corners android:topLeftRadius="24dp" android:topRightRadius="24dp" />
        </shape>
    </item>
</layer-list>
