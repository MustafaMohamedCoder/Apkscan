<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="@color/login_top"
                android:centerColor="@color/login_mid"
                android:endColor="@color/login_bottom" />
        </shape>
    </item>
    <item android:width="470dp" android:height="470dp" android:gravity="top|end" android:right="-150dp" android:top="-160dp">
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="300dp" android:startColor="#355EE8F2" android:endColor="#005EE8F2" />
        </shape>
    </item>
    <item android:width="380dp" android:height="380dp" android:gravity="bottom|start" android:left="-120dp" android:bottom="-150dp">
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="250dp" android:startColor="#267EEDE6" android:endColor="#007EEDE6" />
        </shape>
    </item>
</layer-list>
