<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingBottom="120dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="20dp"
        android:paddingEnd="18dp"
        android:paddingBottom="20dp">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings"
            android:textSize="28sp"
            android:includeFontPadding="false"
            android:fontFamily="@font/tajawal_bold" />

        <LinearLayout
            android:id="@+id/item_theme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="68dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/card_surface_settings"
            android:gravity="center_vertical"
            android:paddingStart="18dp"
            android:paddingTop="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="14dp">
            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_sun"
                android:contentDescription="@string/settings" />
            <TextView
                android:id="@+id/tv_theme_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:textSize="16sp"
                android:includeFontPadding="false"
                android:fontFamily="@font/tajawal_bold" />
            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_close"
                android:rotation="135"
                android:contentDescription="@string/settings" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/item_app_lock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="68dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/card_surface_settings"
            android:gravity="center_vertical"
            android:paddingStart="18dp"
            android:paddingTop="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="14dp">
            <ImageView android:layout_width="36dp" android:layout_height="36dp" android:src="@drawable/ic_key" android:contentDescription="@string/app_lock" />
            <TextView android:id="@+id/tv_app_lock_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="16dp" android:textSize="16sp" android:includeFontPadding="false" android:fontFamily="@font/tajawal_bold" />
            <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_close" android:rotation="135" android:contentDescription="@string/app_lock" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/item_accounts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="68dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/card_surface_settings"
            android:gravity="center_vertical"
            android:paddingStart="18dp"
            android:paddingTop="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="14dp">
            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_people"
                android:contentDescription="@string/settings" />
            <TextView
                android:id="@+id/tv_accounts_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:textSize="16sp"
                android:includeFontPadding="false"
                android:fontFamily="@font/tajawal_bold" />
            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_close"
                android:rotation="135"
                android:contentDescription="@string/settings" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/item_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="68dp"
            android:visibility="gone"
            android:layout_marginTop="10dp"
            android:background="@drawable/card_surface_settings"
            android:gravity="center_vertical"
            android:paddingStart="18dp"
            android:paddingTop="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="14dp">
            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_key"
                android:contentDescription="@string/settings" />
            <TextView
                android:id="@+id/tv_password_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:textSize="16sp"
                android:includeFontPadding="false"
                android:fontFamily="@font/tajawal_bold" />
            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_close"
                android:rotation="135"
                android:contentDescription="@string/settings" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/item_activity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="68dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/card_surface_settings"
            android:gravity="center_vertical"
            android:paddingStart="18dp"
            android:paddingTop="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="14dp">
            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_history"
                android:contentDescription="@string/settings" />
            <TextView
                android:id="@+id/tv_activity_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:textSize="16sp"
                android:includeFontPadding="false"
                android:fontFamily="@font/tajawal_bold" />
            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_close"
                android:rotation="135"
                android:contentDescription="@string/settings" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/item_trash"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="68dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/card_surface_settings"
            android:gravity="center_vertical"
            android:paddingStart="18dp"
            android:paddingTop="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="14dp">
            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_delete"
                android:contentDescription="@string/trash" />
            <TextView
                android:id="@+id/tv_trash_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:textSize="16sp"
                android:includeFontPadding="false"
                android:fontFamily="@font/tajawal_bold" />
            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_close"
                android:rotation="135"
                android:contentDescription="@string/trash" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/item_auto_trash_purge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="80dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/card_surface_settings"
            android:gravity="center_vertical"
            android:paddingStart="18dp"
            android:paddingTop="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_history"
                android:contentDescription="@string/auto_trash_purge" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_auto_trash_purge_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/auto_trash_purge"
                    android:textSize="16sp"
                    android:includeFontPadding="false"
                    android:fontFamily="@font/tajawal_bold" />

                <TextView
                    android:id="@+id/tv_auto_trash_purge_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/auto_trash_purge_summary"
                    android:textSize="13sp"
                    android:includeFontPadding="false"
                    android:fontFamily="@font/tajawal_regular" />
            </LinearLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switch_auto_trash_purge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/enable_auto_trash_purge" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/item_invoice_reminders"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="80dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/card_surface_settings"
            android:gravity="center_vertical"
            android:paddingStart="18dp"
            android:paddingTop="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_history"
                android:contentDescription="@string/invoice_alerts" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/invoice_alerts"
                    android:textSize="16sp"
                    android:includeFontPadding="false"
                    android:fontFamily="@font/tajawal_bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/invoice_alerts_summary"
                    android:textSize="13sp"
                    android:includeFontPadding="false"
                    android:fontFamily="@font/tajawal_regular" />
            </LinearLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switch_invoice_reminders"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/enable_invoice_alerts" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/item_call_ringtone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="80dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/card_surface_settings"
            android:gravity="center_vertical"
            android:paddingStart="18dp"
            android:paddingTop="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_call"
                android:contentDescription="@string/call_ringtones" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/call_ringtones"
                    android:textSize="16sp"
                    android:includeFontPadding="false"
                    android:fontFamily="@font/tajawal_bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/call_ringtones_summary"
                    android:textSize="13sp"
                    android:includeFontPadding="false"
                    android:fontFamily="@font/tajawal_regular" />
            </LinearLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switch_call_ringtone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/enable_call_ringtones" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/item_call_vibration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="80dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/card_surface_settings"
            android:gravity="center_vertical"
            android:paddingStart="18dp"
            android:paddingTop="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_call"
                android:contentDescription="@string/call_vibration" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/call_vibration"
                    android:textSize="16sp"
                    android:includeFontPadding="false"
                    android:fontFamily="@font/tajawal_bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/call_vibration_summary"
                    android:textSize="13sp"
                    android:includeFontPadding="false"
                    android:fontFamily="@font/tajawal_regular" />
            </LinearLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switch_call_vibration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/enable_call_vibration" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/item_call_ringtone_picker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="68dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/card_surface_settings"
            android:gravity="center_vertical"
            android:paddingStart="18dp"
            android:paddingTop="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="14dp">
            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_call"
                android:contentDescription="@string/choose_incoming_call_ringtone" />
            <TextView
                android:id="@+id/tv_call_ringtone_picker_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:textSize="16sp"
                android:includeFontPadding="false"
                android:fontFamily="@font/tajawal_bold" />
            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_close"
                android:rotation="135"
                android:contentDescription="@string/choose_incoming_call_ringtone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/item_call_ice_failure_alert"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="80dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/card_surface_settings"
            android:gravity="center_vertical"
            android:paddingStart="18dp"
            android:paddingTop="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_call"
                android:contentDescription="@string/ice_failure_alert" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/repeated_connection_issue_alert"
                    android:textSize="16sp"
                    android:includeFontPadding="false"
                    android:fontFamily="@font/tajawal_bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/repeated_connection_issue_summary"
                    android:textSize="13sp"
                    android:includeFontPadding="false"
                    android:fontFamily="@font/tajawal_regular" />
            </LinearLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switch_call_ice_failure_alert"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/ice_failure_alert" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/item_help"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="68dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/card_surface_settings"
            android:gravity="center_vertical"
            android:paddingStart="18dp"
            android:paddingTop="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="14dp">
            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_settings_filled"
                android:contentDescription="@string/help_center" />
            <TextView
                android:id="@+id/tv_help_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:textSize="16sp"
                android:includeFontPadding="false"
                android:fontFamily="@font/tajawal_bold" />
            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_close"
                android:rotation="135"
                android:contentDescription="@string/help_center" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/item_export"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="68dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/card_surface_settings"
            android:gravity="center_vertical"
            android:paddingStart="18dp"
            android:paddingTop="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="14dp">
            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_export"
                android:contentDescription="@string/settings" />
            <TextView
                android:id="@+id/tv_export_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:textSize="16sp"
                android:includeFontPadding="false"
                android:fontFamily="@font/tajawal_bold" />
            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_close"
                android:rotation="135"
                android:contentDescription="@string/settings" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/item_storage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="68dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/card_surface_settings"
            android:gravity="center_vertical"
            android:paddingStart="18dp"
            android:paddingTop="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="14dp">
            <ImageView android:layout_width="36dp" android:layout_height="36dp" android:src="@drawable/ic_settings_filled" android:contentDescription="إدارة التخزين" />
            <TextView android:id="@+id/tv_storage_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="16dp" android:textSize="16sp" android:includeFontPadding="false" android:fontFamily="@font/tajawal_bold" />
            <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_close" android:rotation="135" android:contentDescription="إدارة التخزين" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/item_import"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="68dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/card_surface_settings"
            android:gravity="center_vertical"
            android:paddingStart="18dp"
            android:paddingTop="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="14dp">
            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_import"
                android:contentDescription="@string/settings" />
            <TextView
                android:id="@+id/tv_import_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:textSize="16sp"
                android:includeFontPadding="false"
                android:fontFamily="@font/tajawal_bold" />
            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_close"
                android:rotation="135"
                android:contentDescription="@string/settings" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/item_sync"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="68dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/card_surface_settings"
            android:gravity="center_vertical"
            android:paddingStart="18dp"
            android:paddingTop="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="14dp">
            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_sync"
                android:contentDescription="@string/local_sync" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tv_sync_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:includeFontPadding="false"
                    android:fontFamily="@font/tajawal_bold" />
                <TextView
                    android:id="@+id/tv_sync_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textSize="12sp"
                    android:includeFontPadding="false"
                    android:fontFamily="@font/tajawal_regular" />
            </LinearLayout>
            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_close"
                android:rotation="135"
                android:contentDescription="@string/local_sync" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/item_logout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="68dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/card_surface_settings"
            android:gravity="center_vertical"
            android:paddingStart="18dp"
            android:paddingTop="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="14dp">
            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_logout"
                android:contentDescription="@string/settings" />
            <TextView
                android:id="@+id/tv_logout_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:textSize="16sp"
                android:includeFontPadding="false"
                android:fontFamily="@font/tajawal_bold" />
            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_close"
                android:rotation="135"
                android:contentDescription="@string/settings" />
        </LinearLayout>

        <TextView
            android:id="@+id/version_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="36dp"
            android:text="الإصدار 1.0.0"
            android:textSize="13sp"
            android:includeFontPadding="false"
            android:fontFamily="@font/tajawal_regular" />

    </LinearLayout>
</ScrollView>
