<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/group_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="20dp"
    android:layout_marginEnd="20dp"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="22dp"
    app:cardElevation="2dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/day_card_stroke">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
            android:minHeight="88dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="12dp"
        android:paddingBottom="14dp">

        <!-- أيقونة المجلد داخل دائرة بتدرج Teal -->
        <FrameLayout
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="@drawable/group_icon_bg"
            android:layout_gravity="center_vertical">
            <ImageView
                android:id="@+id/group_icon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_folder"
                app:tint="#FFFFFF"
                android:contentDescription="@string/nav_groups" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/group_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="19sp"
                    android:singleLine="true"
                    android:includeFontPadding="false"
                    android:fontFamily="@font/tajawal_bold" />
                <ImageView
                    android:id="@+id/group_pin"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="6dp"
                    android:src="@drawable/ic_pin"
                    android:visibility="gone"
                    android:contentDescription="مجموعة مثبتة" />
            </LinearLayout>

            <TextView
                android:id="@+id/group_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="13sp"
                android:includeFontPadding="false"
                android:fontFamily="@font/tajawal_medium"
                android:textColor="@color/day_text_secondary" />
        </LinearLayout>

        <ImageView
            android:id="@+id/group_more"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:src="@drawable/ic_more"
            android:background="@drawable/nav_item_bg"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/edit" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
