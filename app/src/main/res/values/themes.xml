<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MasahHisabat" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/primary_light</item>
        <item name="colorOnPrimaryContainer">@color/primary_dark</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="android:statusBarColor">@color/ic_bg</item>
        <item name="android:navigationBarColor">@color/ic_bg</item>
        <item name="android:windowBackground">@color/night_background</item>
        <item name="fontFamily">@font/tajawal_regular</item>
        <item name="android:textViewStyle">@style/TextStyle</item>
        <item name="android:buttonStyle">@style/TextStyle</item>
        <item name="android:editTextStyle">@style/TextStyle</item>
        <item name="shapeAppearanceSmallComponent">@style/Shape.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/Shape.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/Shape.Large</item>
    </style>

    <style name="Theme.MasahHisabat.Login" parent="Theme.MasahHisabat">
        <item name="android:windowBackground">@drawable/login_bg</item>
    </style>

    <style name="TextStyle" parent="@android:style/Widget.TextView">
        <item name="android:fontFamily">@font/tajawal_regular</item>
    </style>

    <style name="Shape.Small" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerSize">12dp</item>
    </style>

    <style name="Shape.Medium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerSize">16dp</item>
    </style>

    <style name="Shape.Large" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerSize">28dp</item>
    </style>
</resources>
