<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/content_horizontal_margin"
        android:layout_marginEnd="@dimen/content_horizontal_margin" />

    <!-- جرس الإشعارات يظل ظاهرًا فوق المحتوى، وشارته مشتقة من السجل غير المقروء. -->
    <FrameLayout
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="18dp"
        android:layout_marginTop="18dp">

        <ImageButton
            android:id="@+id/notifications_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:background="@drawable/nav_item_active_bg"
            android:contentDescription="@string/notifications"
            android:padding="12dp"
            android:src="@drawable/ic_notifications" />

        <TextView
            android:id="@+id/notifications_badge"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:layout_gravity="top|right"
            android:background="@drawable/notification_badge_background"
            android:gravity="center"
            android:minWidth="20dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:textColor="@android:color/white"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>

    <!-- مدخل مراسلة دائم فوق المحتوى، بعيد عن شريط التنقل السفلي. -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/floating_messages"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="132dp"
        android:contentDescription="فتح المراسلات"
        android:elevation="14dp"
        app:backgroundTint="@color/accent"
        app:srcCompat="@drawable/ic_chat_bubble"
        app:tint="@android:color/white" />

    <!-- هوية ماسح الحسابات: شريط عائم واضح بحد عرض مريح للأجهزة اللوحية. -->
    <LinearLayout
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:layout_gravity="bottom|center_horizontal"
        android:maxWidth="@dimen/nav_bar_max_width"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="16dp"
        android:paddingStart="6dp"
        android:paddingTop="8dp"
        android:paddingEnd="6dp"
        android:paddingBottom="12dp"
        android:elevation="10dp"
        android:background="@drawable/nav_bar_bg"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/nav_home"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="64dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:paddingTop="4dp"
            android:paddingBottom="2dp"
            android:background="@drawable/nav_item_bg"
            android:foreground="?attr/selectableItemBackgroundBorderless">
            <ImageView
                android:id="@+id/nav_home_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_home"
                android:contentDescription="@string/nav_home" />
            <TextView
                android:id="@+id/nav_home_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/nav_home"
                android:textSize="11sp"
                android:includeFontPadding="false"
                android:textColor="@color/accent" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_groups"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="64dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:paddingTop="4dp"
            android:paddingBottom="2dp"
            android:background="@drawable/nav_item_bg"
            android:foreground="?attr/selectableItemBackgroundBorderless">
            <ImageView
                android:id="@+id/nav_groups_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_groups_filled"
                android:contentDescription="@string/nav_groups" />
            <TextView
                android:id="@+id/nav_groups_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/nav_groups"
                android:textSize="11sp"
                android:includeFontPadding="false"
                android:textColor="@color/navigation_inactive_day" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_scanner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="72dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:paddingTop="4dp"
            android:paddingBottom="2dp"
            android:background="@drawable/nav_item_bg"
            android:foreground="?attr/selectableItemBackgroundBorderless">
            <FrameLayout
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:background="@drawable/scanner_fab_bg"
                android:layout_gravity="center_horizontal">
                <ImageView
                    android:id="@+id/nav_scanner_icon"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_scanner_white"
                    android:contentDescription="@string/nav_scanner" />
            </FrameLayout>
            <TextView
                android:id="@+id/nav_scanner_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/nav_scanner"
                android:textSize="11sp"
                android:includeFontPadding="false"
                android:textColor="@color/navigation_inactive_day" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_search"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="64dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:paddingTop="4dp"
            android:paddingBottom="2dp"
            android:background="@drawable/nav_item_bg"
            android:foreground="?attr/selectableItemBackgroundBorderless">
            <ImageView
                android:id="@+id/nav_search_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_search_filled"
                android:contentDescription="@string/nav_search" />
            <TextView
                android:id="@+id/nav_search_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/nav_search"
                android:textSize="11sp"
                android:includeFontPadding="false"
                android:textColor="@color/navigation_inactive_day" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_theme"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="64dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:paddingTop="4dp"
            android:paddingBottom="2dp"
            android:background="@drawable/nav_item_bg"
            android:foreground="?attr/selectableItemBackgroundBorderless">
            <ImageView
                android:id="@+id/nav_theme_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_sun_filled"
                android:contentDescription="@string/nav_theme" />
            <TextView
                android:id="@+id/nav_theme_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/nav_theme"
                android:textSize="11sp"
                android:includeFontPadding="false"
                android:textColor="@color/navigation_inactive_day" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_settings"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="64dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:paddingTop="4dp"
            android:paddingBottom="2dp"
            android:background="@drawable/nav_item_bg"
            android:foreground="?attr/selectableItemBackgroundBorderless">
            <ImageView
                android:id="@+id/nav_settings_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_settings_filled"
                android:contentDescription="@string/nav_settings" />
            <TextView
                android:id="@+id/nav_settings_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/nav_settings"
                android:textSize="11sp"
                android:includeFontPadding="false"
                android:textColor="@color/navigation_inactive_day" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
