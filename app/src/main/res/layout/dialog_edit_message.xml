<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tv_text_section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="نص الرسالة"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_message_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/input_bg"
            android:hint="اكتب نص الرسالة..."
            android:gravity="top"
            android:minHeight="80dp"
            android:padding="14dp" />

        <TextView
            android:id="@+id/tv_img_section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="بيانات الصورة"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_store"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/input_bg"
            android:hint="اسم المتجر / الموضوع"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:singleLine="true" />

        <EditText
            android:id="@+id/et_date"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/input_bg"
            android:hint="التاريخ (yyyy-MM-dd)"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:singleLine="true" />

        <EditText
            android:id="@+id/et_total"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/input_bg"
            android:hint="المبلغ"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:singleLine="true" />

        <EditText
            android:id="@+id/et_items"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/input_bg"
            android:hint="تفاصيل الفاتورة"
            android:gravity="top"
            android:minHeight="80dp"
            android:padding="14dp" />

    </LinearLayout>
</ScrollView>
