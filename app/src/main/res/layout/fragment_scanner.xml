<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scanner_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="28dp">

    <ImageView
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/ic_launcher_foreground"
        android:contentDescription="@string/app_name" />

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/nav_scanner"
        android:textSize="26sp"
        android:fontFamily="@font/tajawal_bold" />

    <TextView
        android:id="@+id/hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/scan_tap"
        android:textSize="14sp"
        android:textColor="@color/day_text_secondary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/btn_camera"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="10dp"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/scanner_tile_bg"
            android:elevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="30dp">

                <ImageView
                    android:id="@+id/icon_camera"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:src="@drawable/ic_camera_white"
                    android:contentDescription="@string/nav_scanner" />

                <TextView
                    android:id="@+id/label_camera"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="الكاميرا"
                    android:textSize="16sp"
                    android:fontFamily="@font/tajawal_bold"
                    android:textColor="#FFFFFF" />
            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/btn_gallery"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/scanner_tile_bg"
            android:elevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="30dp">

                <ImageView
                    android:id="@+id/icon_gallery"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:src="@drawable/ic_gallery_white"
                    android:contentDescription="@string/nav_groups" />

                <TextView
                    android:id="@+id/label_gallery"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="المعرض"
                    android:textSize="16sp"
                    android:fontFamily="@font/tajawal_bold"
                    android:textColor="#FFFFFF" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

</LinearLayout>
