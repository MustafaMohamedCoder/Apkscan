<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/team_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:src="@drawable/ic_close"
            android:contentDescription="@string/close" />

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/team_management"
            android:textSize="22sp"
            android:fontFamily="@font/tajawal_bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_add_member"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="@string/add_member"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:fontFamily="@font/tajawal_medium"
            android:backgroundTint="@color/accent"
            app:cornerRadius="14dp" />
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/current_user_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingBottom="14dp">

            <TextView
                android:id="@+id/current_user_avatar"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:gravity="center"
                android:background="@drawable/group_icon_bg"
                android:fontFamily="@font/tajawal_bold"
                android:textColor="@color/white"
                android:textSize="21sp"
                android:contentDescription="المستخدم المتصل" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/current_user_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/tajawal_bold"
                    android:textSize="18sp"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/current_user_role"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/tajawal_medium"
                    android:textSize="12sp"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <TextView
                android:id="@+id/current_user_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/online_status_bg"
                android:fontFamily="@font/tajawal_bold"
                android:paddingStart="10dp"
                android:paddingTop="6dp"
                android:paddingEnd="10dp"
                android:paddingBottom="6dp"
                android:textSize="11sp"
                android:includeFontPadding="false" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/empty_members"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="60dp"
        android:background="@drawable/empty_state_panel"
        android:gravity="center"
        android:padding="20dp"
        android:text="لا يوجد أعضاء حتى الآن"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/members_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp"
        android:clipToPadding="false" />

</LinearLayout>
